# EMC Helpline — hybrid LLM layer configuration (PLANLLM Phase 1)
# All variables are optional. Without any provider key the hybrid layer is
# disabled and the chatbot behaves exactly like before (static matching +
# validated answers + deterministic flows).

# Preferred provider for the LLM understanding layer: gemini | groq | openrouter
# (default "gemini"). The chain is always tried in order gemini → groq →
# openrouter, among providers that have a key.
LLM_PROVIDER=gemini

# Provider API keys (at least one is required to enable the hybrid layer).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Chat models per provider (defaults: Gemini 2.5 Flash, Groq Llama 3.3 70B).
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite 
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# OpenRouter model id (required when LLM_PROVIDER=openrouter).
OPENROUTER_MODEL=

# Request timeout per provider call, in milliseconds (default 6000).
LLM_TIMEOUT_MS=6000

# Max retries per provider (default 1; 429s retry after 1 s, bad-JSON retry at
# temperature 0). Failures move to the next provider in the chain.
LLM_MAX_RETRIES=1

# Allow the classifier to answer unrelated small talk warmly (default true).
LLM_SMALLTALK=true

# Per-client request caps (defaults: 10/min, 200/day). When exceeded, the
# message gets today's normal fallback — never an error, never a 429.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200

# Caps that gate the LLM path (fallback beyond them). Char limit per message,
# turns per session.
MESSAGE_CHAR_LIMIT=500
SESSION_TURN_CAP=30

# Log one JSON line per LLM turn ("emc-meta") without any message content.
ENABLE_META_LOGGING=false

# Cache repeated message+context classifier results (default true).
ENABLE_RESPONSE_CACHE=true